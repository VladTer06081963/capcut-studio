# Cloud AI providers (required for AI generation path)

# Kie.ai — unified video/image/audio/LLM API.
# Current code config default for video routing. Credit-based: a default or
# configured key is NOT approval to generate. Get explicit user approval for
# the provider and the exact model before every run.
# Do not use paid retry/fallback without the same approval.
# Price research, price snapshots, output-count caps and spend caps are NOT
# required as a precondition — the user may check prices independently.
# See AGENTS.md → "AI providers".
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai
# Separate host for the upload endpoints.
KIE_UPLOAD_BASE=https://kieai.redpandaai.co
# Where to cache downloaded result files (Kie URLs expire ~24h)
KIE_DOWNLOAD_DIR=./.tmp/kie_downloads
# Model the smoke harness (scripts/test_kie.py) exercises.
# KIE_MODEL=kling/v2-1-master-text-to-video
# Set to 0 to run the smoke harness in discovery-only mode — no credits spent.
# KIE_SMOKE=0

# MiniMax direct API (legacy integration; the current ProviderRouter does not
# implement a direct "minimax" backend). Image generation is covered by the
# user's subscription: still obtain approval of the model, but do not impose
# usage limits, per-image prices, or a monetary/credit cap. See AGENTS.md →
# "AI providers".
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1

# OpenRouter (text route/fallback used by spec_writer when its routing
# conditions select it). Its model is chosen by the caller; DEFAULT_TEXT_PROVIDER
# alone does not set spec_writer.py's DEFAULT_MODEL.
# Get at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google AI Studio (Gemini API) — Free tier for text/multimodal processing
# Get at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Native Gemini endpoint (generateContent) — this is what the spec writer
# actually calls. The key is sent in the x-goog-api-key header, not in the
# URL, so it does not end up in proxy or server logs.
GEMINI_NATIVE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Stock library sources
# Note (2026-10): Pixabay and Pexels web interfaces return HTTP 403 from
# Ukraine IPs. Their API servers may still answer with a valid key, but
# we don't rely on them. Sources below are UA-friendly and confirmed working.

# YouTube Data API v3 — https://console.cloud.google.com/apis/credentials
# CONFIRMED working from UA. Primary stock source.
YOUTUBE_API_KEY=

# Coverr — https://coverr.co/api
# Free, no attribution. API requires signup. CONFIRMED web reachable from UA.
COVERR_API_KEY=

# Mixkit (Envato) — https://mixkit.co/free-stock-video/
# Free, no attribution. NO public API — ingest via scrape (see capcut/ingest/mixkit.py).
# Set MIXKIT_SCRAPE_DELAY_SEC to be polite (default 2.0).
MIXKIT_SCRAPE_DELAY_SEC=2.0

# Archive.org — https://archive.org/developers/
# Public-domain footage. Has API. Small but stable. Last-resort fallback.
# Anonymous access works for low volume.
# NOTE: capcut/ingest/archive.py reads no environment variable today, so
# ARCHIVE_API_KEY is inert — setting it changes nothing yet.
# ARCHIVE_API_KEY=

# Pixabay — https://pixabay.com/api/docs/
# ⚠️  Blocked from UA (web 403, API unknown).
# NOTE: there is no Pixabay ingest source in the tree yet, so setting this
# key changes nothing today. Kept for the planned source (AGENTS.md).
PIXABAY_API_KEY=

# Pexels — https://www.pexels.com/api/
# ⚠️  Web 403 from UA, key issuance paused globally.
# NOTE: same as Pixabay — no ingest source exists yet, so the key is inert.
PEXELS_API_KEY=

# Local indexer (LM Studio running the BLIP-2 / CLIP server)
LM_STUDIO_URL=http://127.0.0.1:1234
LM_STUDIO_EMBED_MODEL=bge-large-en-v1.5
LM_STUDIO_CAPTION_MODEL=blip-2
# Optional bearer token if LM Studio has auth enabled.
# Find in LM Studio: Settings → Developer → API Token
LM_STUDIO_API_TOKEN=

# Concat MCP (auto-composer) — not used by this project: the Concat.app CLI
# is driven directly (mcp-server/index.js → `open -a Concat.app`).
# CONCAT_MCP_URL=http://127.0.0.1:9847

# Library paths
LIBRARY_ROOT=./library
LIBRARY_INDEX=./library/index.sqlite
LIBRARY_TEMP=./.tmp

# Output paths
SERIALS_ROOT=./serials

# Runtime config defaults only; these values can select paid models and are
# NOT authorization to spend. Paid generation requires explicit user approval
# of the provider and the exact model.
# Format: "<backend>/<model_id>" — use kie-models skill to discover live model names
DEFAULT_VIDEO_PROVIDER=kie/veo-3-1
# Comma-separated candidate list. Current ProviderRouter.generate() does not
# automatically load this env value; only an explicitly passed fallback list
# is used. Do not enable paid fallbacks without explicit approval of the
# alternative provider and model.
DEFAULT_VIDEO_FALLBACK=kling/v2-1-master-text-to-video,runway/gen-4-turbo,bytedance/seedance-2.0
DEFAULT_TEXT_PROVIDER=qwen3-max
DEFAULT_IMAGE_PROVIDER=qwen-image

# Planned budget setting only: current code does not enforce this cap and
# cron/nightly.sh is absent. Do not treat it as spend protection.
# Tracked as an open item in summary/tasks/025_… (P0-1) and
# openspec/changes/approval-enforcement-and-spec-binding/ — the constant is
# currently defined but never consulted.
DAILY_AI_BUDGET_USD=10