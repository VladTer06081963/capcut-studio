# Secrets
.env
.env.*
# ...but the template is documentation, not a secret: it must be tracked so a
# fresh clone has the env contract. Without this, `cp .env.example .env`
# (AGENTS.md) and scripts/setup_keys.sh fail on any other machine.
!.env.example
*.secret
config.local.*

# Python
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
.mypy_cache/

# Node
node_modules/
# package-lock.json IS tracked. Without it `npm ci` is impossible and the
# MCP SDK floats on ^1.32.1 — a fresh clone would not reproduce the
# installed dependency tree.
npm-debug.log*

# Library (assets are large; generated by ingest + AI)
# `library` itself is a symlink to the external HDD on this machine
# (/Volumes/MacStudioData/UserData/capcut-library) — it must never be
# committed: it dangles on any other clone and leaks a local path.
library
library/ai/
library/stock/
library/index.sqlite
library/index.sqlite-*
library/.tmp/

# Output (regeneratable)
serial/*/rendered/
serials/*/rendered/
serials/*/matched.json
# Nested episode paths are serials/<show>/<ep-id>/... — the single-level
# patterns above do NOT match those.
serials/**/matched.json
serials/**/rendered/
.tmp/

# Lifecycle sentinels are per-episode runtime state, not source.
# A committed `.approved` means every clone starts with a pre-approved
# episode.
serials/**/.approved
serials/**/.draft

# Final-render temp artifacts (regenerated on every render)
serials/**/rendered/capcut_final_*_concat.txt
serials/**/rendered/.final.mp4.*.tmp.mp4

# Logs
data/logs/
*.log

# OS / IDE
.DS_Store
.vscode/
.idea/

# Comic-studio shared
.comic-studio-cache/
# Rendered / downloaded video (large binaries)
serials/**/rendered/*.mp4
summary/*.mp4
*.mp4
!library/**/.gitkeep
